<div id="<%= dom_id note %>" class="space-y-3">
  <div>
    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Title</p>
    <h2 class="mt-1 text-xl font-semibold text-white"><%= note.title %></h2>
  </div>

  <div>
    <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Content</p>
    <p class="mt-1 whitespace-pre-wrap text-sm leading-6 text-slate-300"><%= note.content %></p>
  </div>
</div>
