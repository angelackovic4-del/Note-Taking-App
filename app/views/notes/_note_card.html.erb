<%= turbo_frame_tag dom_id(note) do %>
  <article class="rounded-xl border border-slate-800 bg-slate-900 p-6 transition hover:border-indigo-500/60">
    <%= render partial: "notes/note", locals: { note: note, preview: true } %>
    <div class="mt-5 flex gap-4 text-sm font-semibold">
      <%= link_to "Read note", note, data: { turbo_frame: "_top" }, class: "text-indigo-400 hover:text-indigo-300" %>
      <%= link_to "Edit", edit_note_path(note), data: { turbo_frame: dom_id(note) }, class: "text-slate-400 hover:text-white" %>
    </div>
  </article>
<% end %>
