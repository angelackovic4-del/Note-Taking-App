<% content_for :title, "New note" %>

<div class="mx-auto max-w-2xl">
  <p class="mb-2 text-sm font-medium uppercase tracking-widest text-indigo-400">Create</p>
  <h1 class="text-4xl font-bold tracking-tight text-white">New note</h1>

  <div class="mt-8 rounded-xl border border-slate-800 bg-slate-900 p-6 sm:p-8">
    <%= render "form", note: @note %>
  </div>

  <%= link_to "Back to notes", notes_path, class: "mt-6 inline-block text-sm font-semibold text-slate-400 hover:text-white" %>
</div>
